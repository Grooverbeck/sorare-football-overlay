{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sorare-football-overlay-api",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "LOG_LEVEL": "info",
    "MOCK_MODE": "false",
    "EXCLUDE_LOW_COVERAGE": "true",
    "PLAYER_FORM_CACHE_TTL_SECONDS": "604800",
    "FIXTURE_CACHE_TTL_SECONDS": "14400",
    "NAME_CACHE_TTL_SECONDS": "2592000",
    "NAME_MISS_CACHE_TTL_SECONDS": "7200",
    "SORARE_BATCH_SIZE": "25",
    "SORARE_REQUEST_TIMEOUT_MS": "10000",
    "SORARE_MAX_RETRIES": "3",
    "SORARE_GRAPHQL_URL": "https://api.sorare.com/graphql",
    "ODDS_API_BASE_URL": "https://api.the-odds-api.com/v4",
    "ODDS_API_SPORT_KEY": "soccer_usa_mls",
    "ODDS_API_REGION": "us",
    "ODDS_API_FALLBACK_REGION": "uk",
    "ODDS_FETCH_WINDOW_HOURS": "72",
    "MATCH_ODDS_FALLBACK_WINDOW_HOURS": "72",
    "ODDS_MISS_CACHE_TTL_SECONDS": "21600",
    "SPORTS_GAME_ODDS_BASE_URL": "https://api.sportsgameodds.com/v2",
    "SPORTS_GAME_ODDS_LEAGUE_ID": "MLS",
    "ODDS_API_IO_BASE_URL": "https://api.odds-api.io/v3",
    "ODDS_API_IO_LEAGUE": "austria-bundesliga",
    "ODDS_API_IO_BOOKMAKERS": "Bet365,Unibet",
    "ODDS_API_IO_DAILY_REQUEST_LIMIT": "500",
    "ODDS_API_IO_HOURLY_REQUEST_LIMIT": "100",
    "CORS_ORIGINS": "http://localhost:5173"
  },
  "secrets": {
    "required": [
      "SORARE_API_KEY",
      "THE_ODDS_API_KEY",
      "SPORTS_GAME_ODDS_API_KEY",
      "ODDS_API_IO_KEY"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "STATS_CACHE"
    }
  ],
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "database_name": "sorare-overlay-cache",
      "database_id": "d6ce9d0e-23e5-4b7d-a88b-afe8593aad18",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 5 * * *", "0 10 * * MON"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
