PORT=8787
LOG_LEVEL=info
MOCK_MODE=true
EXCLUDE_LOW_COVERAGE=true
PLAYER_FORM_CACHE_TTL_SECONDS=86400
FIXTURE_CACHE_TTL_SECONDS=14400
NAME_CACHE_TTL_SECONDS=2592000
NAME_MISS_CACHE_TTL_SECONDS=7200
SORARE_BATCH_SIZE=25
SORARE_REQUEST_TIMEOUT_MS=10000
SORARE_MAX_RETRIES=3
SORARE_GRAPHQL_URL=https://api.sorare.com/graphql
# Optional. Keep these values on the backend only.
SORARE_API_KEY=
SORARE_AUTH_TOKEN=
SORARE_JWT_AUD=
# Comma-separated. chrome-extension:// origins are allowed automatically.
CORS_ORIGINS=http://localhost:5173
