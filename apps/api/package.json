{
  "name": "@sorare-overlay/api",
  "version": "0.4.10",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "benchmark:mls-aa": "node --env-file-if-exists=.dev.vars scripts/analyze-mls-aa.mjs",
    "benchmark:mls-cs": "node scripts/analyze-mls-clean-sheets.mjs",
    "benchmark:mls-market": "tsx scripts/derive-mls-market-benchmarks.mjs",
    "benchmark:mls-win": "node scripts/analyze-mls-win-probabilities.mjs",
    "benchmark:sorare-batching": "node --experimental-strip-types --env-file-if-exists=.dev.vars scripts/benchmark-sorare-batching.mjs",
    "analyze:mls-props": "tsx --env-file-if-exists=.dev.vars scripts/analyze-mls-player-props.mjs",
    "analyze:player-prediction": "node --env-file-if-exists=.dev.vars scripts/analyze-player-predictions.mjs",
    "prewarm:mls-props": "node scripts/prewarm-mls-market-odds.mjs",
    "cf:deploy": "wrangler deploy --config wrangler.jsonc",
    "cf:dev": "wrangler dev --config wrangler.jsonc",
    "cf:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "cf:typegen": "wrangler types --config wrangler.jsonc --env-interface CloudflareBindings",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "tsx watch src/index.ts",
    "schema:pull": "node scripts/pull-schema.mjs",
    "start": "node dist/index.js",
    "usage:sports-game-odds": "tsx --env-file-if-exists=.dev.vars scripts/check-sports-game-odds-usage.mjs",
    "test": "npm run test:node && npm run test:worker",
    "test:node": "vitest run",
    "test:worker": "vitest run --config vitest.cloudflare.config.ts",
    "test:watch": "vitest",
    "typecheck": "npm run cf:typegen && npm run typecheck:node && npm run typecheck:worker",
    "typecheck:node": "tsc -p tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@sorare-overlay/shared": "*",
    "dotenv": "^17.2.0",
    "hono": "^4.8.5",
    "pino": "^9.7.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^5.20260723.1",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@types/node": "^24.0.10",
    "graphql": "^16.11.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.113.0"
  }
}
