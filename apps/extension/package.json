{
  "name": "@sorare-overlay/extension",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --target chromium",
    "build:chrome": "node scripts/build.mjs --target chromium",
    "build:firefox": "node scripts/build.mjs --target firefox",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "dev": "node scripts/build.mjs --target chromium --watch",
    "dev:firefox": "node scripts/build.mjs --target firefox --watch",
    "package:store": "node scripts/package-store.mjs",
    "package:firefox": "node scripts/package-firefox.mjs",
    "verify:targets": "node scripts/verify-build-targets.mjs",
    "test:build-targets": "npm run build:chrome && npm run build:firefox && npm run verify:targets",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sorare-overlay/shared": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "dotenv": "^17.2.0",
    "esbuild": "^0.25.6",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
